# Supabase — essas duas são públicas (a "anon key" é feita pra ir no
# navegador, protegida pelas políticas RLS do banco, não por segredo).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service Role — SECRETA, nunca leva o prefixo VITE_. Pega em Project
# Settings → API → "service_role" no painel do Supabase. Usada só pela
# Vercel Function que faz o login do Super Admin (api/admin-login.js),
# nunca chega no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Anthropic — essa NUNCA leva o prefixo VITE_ de propósito, porque
# variáveis com esse prefixo o Vite expõe no navegador. Sem o prefixo,
# ela só existe no lado do servidor (dentro de api/anthropic.js, a
# Vercel Function), nunca chega no navegador de quem visita o site.
ANTHROPIC_API_KEY=sua-chave-aqui
